{
  "name": "@micuintus/llm-wiki",
  "version": "1.5.0",
  "description": "Karpathy 的 LLM Wiki 模式：面向 pi 的极简、跨代理技能",
  "keywords": [
    "pi-package",
    "llm-wiki",
    "karpathy",
    "knowledge-base",
    "second-brain"
  ],
  "homepage": "https://github.com/wangscu/llm-wiki-zh",
  "bugs": {
    "url": "https://github.com/wangscu/llm-wiki-zh/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wangscu/llm-wiki-zh.git"
  },
  "files": [
    "llm-wiki-zh",
    "skills",
    "plugin.json",
    ".codex-plugin",
    ".claude-plugin",
    ".agents",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "sync:skill": "node scripts/sync-skill.mjs",
    "check:skill": "node scripts/sync-skill.mjs --check",
    "test": "node --experimental-strip-types --test"
  },
  "peerDependencies": {
    "@mariozechner/pi-coding-agent": "*"
  },
  "pi": {
    "skills": [
      "./llm-wiki-zh"
    ],
    "extensions": [
      "./llm-wiki-zh/extension.ts"
    ]
  }
}
